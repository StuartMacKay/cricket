# Copy this file to .env.
#
# Everything has a sensible default for local Docker development — you only
# need to uncomment a variable if you want to change it.
#
# Variables that are managed by the Docker network (BROKER_URL, CACHE_URL,
# DATABASE_URL) are set inside docker-compose.yml and must NOT be overridden
# here. Setting them here would replace container-internal hostnames with
# localhost, breaking communication between services.

####################
#  Docker Compose
####################

# Project name used as a prefix in container names and log output.
# Useful when running multiple Compose projects on the same host.
#export COMPOSE_PROJECT_NAME=cricket

# Expose service ports on the host. Uncomment only if the defaults conflict
# with other locally running services.
#export DOCKER_DJANGO_PORT_FORWARD=127.0.0.1:8000
#export DOCKER_REDIS_PORT_FORWARD=127.0.0.1:6379
#export DOCKER_FLOWER_PORT_FORWARD=127.0.0.1:5555

# Restart policy. Change to 'unless-stopped' in production.
#export DOCKER_RESTART_POLICY=no

# Health check command. Set to '/bin/true' in development to suppress
# the health check lines from appearing in log output.
#export DOCKER_DJANGO_HEALTHCHECK_TEST=curl localhost:8000/watchman/ping

###########################
#  Production essentials
###########################

# Startup will raise an error if DJANGO_ENV=production and either
# DJANGO_SECRET_KEY is not set or DJANGO_DEBUG is True.
#export DJANGO_ENV=development
#export DJANGO_DEBUG=True
#export DJANGO_SECRET_KEY=
#export DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

############################
#  Production hardening
############################

# Move the admin to a non-standard path to reduce automated login attempts.
#export DJANGO_ADMIN_PATH=admin/

# Protect the health check endpoint with a token.
# Access it at: /watchman/ping?watchman-token=<token>
#export DJANGO_WATCHMAN_TOKENS=

###########
#  Tuning
###########

# Gunicorn worker processes. In production: (2 × CPU cores) + 1.
#export GUNICORN_NUMBER_OF_WORKERS=1

# Log verbosity.
#export CELERY_LOG_LEVEL=debug
#export GUNICORN_LOG_LEVEL=debug
#export DJANGO_LOG_LEVEL=INFO

################
#  Integrations
################

# Sentry error tracking (optional).
#export DJANGO_SENTRY_DSN=

# Email backend. The default sends to the console (development only).
# Production example: smtp+ssl://user:password@smtp.example.com:465
#export DJANGO_EMAIL_URL=consolemail://
#export DJANGO_EMAIL_USE_SSL=True

# S3-compatible storage for uploaded media files (optional).
# To enable, also set DJANGO_DEFAULT_STORAGE_BACKEND:
#   storages.backends.s3boto3.S3Boto3Storage
#export DJANGO_DEFAULT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
#export AWS_ACCESS_KEY_ID=
#export AWS_SECRET_ACCESS_KEY=
#export AWS_STORAGE_BUCKET_NAME=
# AWS CloudFront CDN domain (optional):
#export AWS_S3_CUSTOM_DOMAIN=
# DigitalOcean Spaces or other S3-compatible endpoint:
#export AWS_S3_REGION_NAME=
#export AWS_S3_ENDPOINT_URL=

# CDN for static files (optional).
# To serve static files from a CDN such as CloudFront, set both:
#export DJANGO_STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage
#export DJANGO_STATIC_HOST=

################
#  Development
################

# API key for accessing the Cricket REST API.
# Run 'make apikey' to generate a key and write it here automatically.
#export CRICKET_API_KEY=
